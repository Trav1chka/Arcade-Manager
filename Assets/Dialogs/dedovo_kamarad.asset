%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 300f5844559acab45b0a9637e17f2a48, type: 3}
  m_Name: dedovo_kamarad
  m_EditorClassIdentifier: Assembly-CSharp::DialogGroup
  groupName: 
  leaveChanceOnNegative: 0.5
  entries:
  - guestPhrase: "Tv\u016Fj d\u011Bda to tu um\u011Bl l\xEDp srovnat. Pro\u010D tu m\xE1\u0161 na zemi takovej nepo\u0159\xE1dek, chlap\u010De?"
    negative:
      text: "Omlouv\xE1m se, je\u0161t\u011B jsem to nestihl uklidit. Zametu to a\u017E po zav\xEDra\u010Dce."
      guestReply: "No hlavn\u011B se vymlouvej. Z\xE1kazn\xEDk to vid\xED hned ode dve\u0159\xED."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "M\u011Bl jsem tu zrovna velkou skupinu z\xE1kazn\xEDk\u016F. \xDAklid m\xE1m v pl\xE1nu hned po zav\xEDra\u010Dce."
      guestReply: "Po zav\xEDra\u010Dce u\u017E je trochu pozd\u011B, kdy\u017E ti v tom lidi \u0161lapou te\u010F. Ale budi\u017E, aspo\u0148 \u017Ee m\xE1\u0161 pl\xE1n."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Nepo\u0159\xE1dek? Tomu se \u0159\xEDk\xE1 stopy po po\u0159\xE1dn\xFDm k\u0161eftu! Kde se pa\u0159\xED, tam holt l\xEDtaj\xED drobky!"
      guestReply: "Takhle to tv\u016Fj d\u011Bda p\u0159esn\u011B \u0159\xEDkal, kdy\u017E nest\xEDhal! M\xE1\u0161 Filipa, to se mus\xED nechat."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Kouk\xE1m na ty automaty, d\u011Bda m\u011Bl skla v\u017Edycky vyle\u0161t\u011Bn\xE1 a ty to m\xE1\u0161 cel\xE9 upatlan\xE9."
    negative:
      text: "Nest\xEDh\xE1m v\u0161echno najednou... ot\u0159u to hadrem, a\u017E bude voln\u011Bji."
      guestReply: "Mus\xED\u0161 si um\u011Bt zorganizovat \u010Das. Upacht\u011Bn\xFD person\xE1l podnik nesprav\xED."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Za pln\xE9ho provozu to le\u0161tit nelze. Desinfekci a \u010Di\u0161t\u011Bn\xED d\u011Bl\xE1m po \u0161icht\u011B."
      guestReply: "Spr\xE1vn\xFD p\u0159\xEDstup. Jen nez\u016Fst\xE1vej jen u slov a opravdu to hl\xEDdej."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Upatlan\xFD skla znamenaj\xED jedin\xE9 \u2013 lidi na ty obrazovky lep\xED nosy a pa\u0159\xED o sto \u0161est!"
      guestReply: "Ha! Argumentovat um\xED\u0161 dob\u0159e. Jen aby ti p\u0159es ty otisky vid\u011Bli na sk\xF3re."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Pro\u010D m\xE1\u0161 ty automaty v \u0159ad\u011B tak nak\u0159ivo? D\u011Bda m\u011Bl v\u0161echno vyrovnan\xE9 podle prav\xEDtka."
    negative:
      text: "J\xE1 to takhle zd\u011Bdil a b\xE1l jsem se s t\xEDm h\xFDbat, abych n\u011Bco neutrhl..."
      guestReply: "Strach ti v podnik\xE1n\xED nepom\u016F\u017Ee. Mus\xED\u0161 m\xEDt pevnou ruku."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Kabely v podlaze maj\xED pevn\xE9 trasy. Kv\u016Fli bezpe\u010Dnosti stoj\xED p\u0159esn\u011B tak, jak maj\xED."
      guestReply: "Dob\u0159e. Hlavn\u011B kdy\u017E o tom v\xED\u0161 a m\xE1 to n\u011Bjak\xFD \u0159\xE1d."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Podle prav\xEDtka je nuda! M\xE1m to ergonomicky rozestav\u011Bn\xE9 tak, aby se lidi nema\u010Dkali a proudil dav!"
      guestReply: "Ergonomicky, jo? Ty modern\xED v\xFDrazy... ale proj\xEDt se tu d\xE1, to uzn\xE1v\xE1m."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Kolik jsi dneska vyd\u011Blal? D\u011Bda by z tebe m\u011Bl ur\u010Dit\u011B radost... nebo snad ne?"
    negative:
      text: "N\u011Bco m\xE1lo jsem vyd\u011Blal, ale popravd\u011B nev\xEDm, jestli by to d\u011Bdovi sta\u010Dilo."
      guestReply: "Mus\xED\u0161 si trochu v\xEDc v\u011B\u0159it, jinak tenhle byznys neut\xE1hne\u0161 ani do V\xE1noc."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "\xDA\u010Dty z toho zaplat\xEDm a zbyde i na n\u011Bjak\xFD ten servis. Vede se mi docela obstojn\u011B."
      guestReply: "To zn\xED rozumn\u011B. Dr\u017E\xED\u0161 se nohama pevn\u011B na zemi, to je z\xE1klad."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "D\u011Bda by ze m\u011B nesk\xE1kal radost\xED, ten by rovnou omdlel, a\u017E by vid\u011Bl tu moji narvanou kasu!"
      guestReply: "Sebev\u011Bdom\xED ti teda rozhodn\u011B nechyb\xED! R\xE1d uvid\xEDm v\xFDsledky, co ta slova dok\xE1\u017Eou podlo\u017Eit."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Zaplat\xED ti v\u016Fbec tyhle star\xE9 hry elekt\u0159inu? \u017Dere to proud jako cel\xE1 fabrika."
    negative:
      text: "N\xE1klady na energii jsou d\u011Bsiv\xE9... n\u011Bkdy se boj\xEDm otev\u0159\xEDt ob\xE1lku s fakturou."
      guestReply: "Zav\xEDrat o\u010Di p\u0159ed tr\u017Ebami a slo\u017Eenkami je cesta do hrobu, chlap\u010De."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "M\xE1m spo\u010D\xEDtanou spot\u0159ebu na hodinu provozu. Ka\u017Ed\xFD automat si na sv\u016Fj proud spolehliv\u011B vyd\u011Bl\xE1."
      guestReply: "Rozumn\xE1 kalkulace. D\u011Bda taky v\u017Edycky po\u010D\xEDtal ka\u017Edou kilowatthodinu."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Elekt\u0159inu? Tyhle ma\u0161iny generuj\xED tolik z\xE1bavy i pen\u011Bz, \u017Ee bych mohl rozsv\xEDtit cel\xE9 n\xE1m\u011Bst\xED!"
      guestReply: "Takovou jiskru v oku m\u011Bl tv\u016Fj d\u011Bda naposledy v devades\xE1tk\xE1ch! Jen tak d\xE1l!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "M\xE1\u0161 v\u016Fbec v pl\xE1nu z toho kr\xE1mku vytvo\u0159it stabiln\xED \u017Eivobyt\xED, nebo je to jen do\u010Dasn\xE1 hra\u010Dka?"
    negative:
      text: "Sna\u017E\xEDm se, jak to jde, ale nev\xEDm, jestli z toho n\u011Bkdy bude stabiln\xED pr\xE1ce..."
      guestReply: "Snaha je hezk\xE1 v\u011Bc, ale nejistota t\u011B polo\u017E\xED. Chce to pevnou vizi."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "M\xE1m podnikatelsk\xFD pl\xE1n na dva roky dop\u0159edu. Tr\u017Eby i odpisy jdou p\u0159esn\u011B podle k\u0159ivky."
      guestReply: "Pl\xE1n je polovina \xFAsp\u011Bchu. Dr\u017E se ho a zbyte\u010Dn\u011B neriskuj."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Do\u010Dasn\xE1 hra\u010Dka?! Do p\u011Bti let z tohohle podniku ud\u011Bl\xE1m nejv\u011Bt\u0161\xED hern\xED fran\u0161\xEDzu v kraji!"
      guestReply: "Krotit v\xE1\u0161n\u011B, chlap\u010De! Ale l\xEDb\xED se mi, \u017Ee hned od za\u010D\xE1tku mysl\xED\u0161 ve velk\xE9m."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Tak co? Zvl\xE1d\xE1\u0161 ten hluk a stres z lid\xED, nebo t\u011B to tady semele?"
    negative:
      text: "Je to ob\u010Das hrozn\u011B vy\u010Derp\xE1vaj\xEDc\xED. N\u011Bkdy se prost\u011B mus\xEDm schovat pod pult a jen chv\xEDli d\xFDchat."
      guestReply: "Nesm\xED\u0161 uk\xE1zat z\xE1kazn\xEDk\u016Fm slabost, jinak ti za\u010Dnou sk\xE1kat po hlav\u011B. Zpevni se."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Stres to je, ale \u010Dlov\u011Bk si zvykne. Zkou\u0161\xEDm si v tom naj\xEDt funk\u010Dn\xED syst\xE9m zpoza pultu."
      guestReply: "P\u0159esn\u011B tak, spolehliv\xFD syst\xE9m t\u011B zachr\xE1n\xED p\u0159ed zbl\xE1zn\u011Bn\xEDm."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Stres? J\xE1 to miluju! \u010C\xEDm v\xEDc lid\xED a krav\xE1lu, t\xEDm lep\u0161\xED energii to tady m\xE1!"
      guestReply: "To opravdu r\xE1d sly\u0161\xEDm. Herna p\u0159esn\u011B pot\u0159ebuje mana\u017Eera s po\u0159\xE1dn\xFDm pulzem!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Vid\u011Bl jsem venku frontu. Co d\u011Bl\xE1\u0161, kdy\u017E ti lidi za\u010Dnou hromadn\u011B bu\u0161it na pult?"
    negative:
      text: "Za\u010Dnu trochu zmatkovat a boj\xEDm se, \u017Ee vyd\xE1m \u0161patn\u011B drobn\xE9..."
      guestReply: "Nejistota t\u011B p\u0159ed lidmi zni\u010D\xED. Pokladn\xED mus\xED p\u016Fsobit neochv\u011Bjn\u011B."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Odbavuji je v klidu jednoho po druh\xE9m. Kdo po\u010Dk\xE1, ten si zahraje."
      guestReply: "To je ten spr\xE1vn\xFD profesion\xE1ln\xED odstup. Nepou\u0161t\u011Bt si hysterii davu k t\u011Blu."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Kdy\u017E bu\u0161\xED na pult, nahod\xEDm \xFAsm\u011Bv, zvednu hlas a ud\u011Bl\xE1m z toho po\u0159\xE1dnou show!"
      guestReply: "Z herny d\u011Bl\xE1\u0161 show, to lidi bav\xED. D\u011Bda byl sp\xED\u0161 morous, tohle ti schvaluju."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Ne\u0159\xEDkej mi, \u017Ee t\u011B bav\xED poslouchat osm hodin v kuse ty stejn\xE9 8-bitov\xE9 melodie."
    negative:
      text: "Up\u0159\xEDmn\u011B mi z toho ob\u010Das t\u0159e\u0161t\xED hlava a nejrad\u0161i bych to cel\xE9 povyp\xEDnal..."
      guestReply: "Tohle zkr\xE1tka nen\xED pr\xE1ce pro citlivky. Bude\u0161 si muset zvyknout."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Vn\xEDm\xE1m to jako b\xEDl\xFD \u0161um v pozad\xED. Soust\u0159ed\xEDm se na pokladnu a bezpe\u010Dnost."
      guestReply: "Rozvaha a soust\u0159ed\u011Bn\xED jsou u t\xE9hle kasy k nezaplacen\xED. Dobr\xE1 pr\xE1ce."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Tyhle melodie jsou soundtrack m\xE9ho \u017Eivota! Ka\u017Ed\xE9 p\xEDpnut\xED znamen\xE1 vhozenou minci!"
      guestReply: "M\xE1\u0161 pravdu, zvuk padaj\xEDc\xEDch minc\xED zn\xED l\xEDp ne\u017E filharmonie. M\xE1\u0161 recht!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "D\u011Bda mi \u0159\xEDkal, \u017Ee jsi hrozn\xFD introvert a mrzout. Kouk\xE1m, \u017Ee se nic nezm\u011Bnilo, co?"
    negative:
      text: "J\xE1 v\xEDm... po\u0159\xE1d to s lidmi popravd\u011B moc neum\xEDm. Rad\u0161i se dr\u017E\xEDm za kasou."
      guestReply: "Bude\u0161 se muset za\u010D\xEDt v\xEDc sna\u017Eit. Z\xE1kazn\xEDk je p\u0159ece tv\u016Fj chleba."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Mo\u017En\xE1 nejsem nejupov\xEDdan\u011Bj\u0161\xED, ale svoji pr\xE1ci zvl\xE1d\xE1m a z\xE1kazn\xEDci se vracej\xED."
      guestReply: "V\xFDsledky mluv\xED samy za sebe. Kdy\u017E se lidi vrac\xED, d\u011Bl\xE1\u0161 to v j\xE1dru dob\u0159e."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Mrzout?! Zeptejte se m\xEDstn\xEDch! Jsem tu srdce a du\u0161e cel\xE9ho ark\xE1dov\xE9ho podniku!"
      guestReply: "Sly\u0161el jsem v okol\xED, \u017Ee se o tob\u011B mluv\xED. P\u0159i\u0161el jsem se p\u0159esv\u011Bd\u010Dit na vlastn\xED o\u010Di."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Kdy\u017E n\u011Bkdo vejde, sotva p\xEDpne\u0161 pozdrav. Takhle se k\u0161eft ned\u011Bl\xE1, chlap\u010De."
    negative:
      text: "Asi m\xE1 pravdu. Sna\u017E\xEDm se, ale nutit se do fale\u0161n\xFDch \xFAsm\u011Bv\u016F mi prost\u011B nejde."
      guestReply: "N\u011Bkdy mus\xED\u0161 nasadit masku, a\u0165 se ti to l\xEDb\xED nebo ne. Je to obchod."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Pozdrav\xEDm v\u011Bcn\u011B a srozumiteln\u011B. Z\xE1kazn\xEDk sem jde hr\xE1t, ne poslouchat rom\xE1ny."
      guestReply: "Mluviti st\u0159\xEDbro, ml\u010Deti zlato. Ale o\u010Dn\xED kontakt a slu\u0161nost dr\u017E\xED podnik nad vodou."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "To platilo mo\u017En\xE1 kdysi! Dneska ka\u017Ed\xE9ho borce v\xEDt\xE1m jak star\xE9ho k\xE1mo\u0161e!"
      guestReply: "Tak to se d\u011Bda v odhadu bu\u010F spletl, nebo jsi ho po\u0159\xE1dn\u011B p\u0159ekvapil. T\xEDm l\xEDp!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "D\u011Bda tvrdil, \u017Ee rad\u0161i zaleze\u0161 do skladu, ne\u017E abys musel \u0159e\u0161it st\xED\u017Enost z\xE1kazn\xEDka."
    negative:
      text: "Je pravda, \u017Ee konfrontace nesn\xE1\u0161\xEDm. V\u011Bt\u0161inou rad\u0161i ustoup\xEDm, aby byl klid..."
      guestReply: "Jen z \xFAstupk\u016F siln\xFD byznys nevybuduje\u0161. Mus\xED\u0161 um\u011Bt st\xE1t pevn\u011B."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Ka\u017Ed\xFD probl\xE9m \u0159e\u0161\xEDm klidn\u011B a podle provozn\xEDho \u0159\xE1du. Bez zbyte\u010Dn\xFDch emoc\xED."
      guestReply: "Tvrd\xE1, ale pravdiv\xE1 logika. Emoce do kasy nepat\u0159\xED, to t\u011B d\u011Bda nau\u010Dil dob\u0159e."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Haha! D\u011Bda m\u011B nevid\u011Bl v akci. J\xE1 st\xED\u017Enosti m\u011Bn\xEDm v loaj\xE1ln\xED z\xE1kazn\xEDky za minutu!"
      guestReply: "To je ono! Ud\u011Blat z nich komunitu, co se r\xE1da vrac\xED. M\xE1\u0161 v sob\u011B obchodn\xEDka."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "N\u011Bkter\xE9 ty automaty u\u017E maj\xED nejlep\u0161\xED roky za sebou. Um\xED\u0161 je v\u016Fbec opravit?"
    negative:
      text: "Moc tomu nerozum\xEDm. V\u011Bt\u0161inou se to popravd\u011B boj\xEDm i otev\u0159\xEDt, abych to nepokazil je\u0161t\u011B v\xEDc."
      guestReply: "Strachem to nesprav\xED\u0161. Bude\u0161 si na to muset zkr\xE1tka naj\xEDt st\xE1l\xE9ho technika."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Z\xE1kladn\xED opravy zvl\xE1dnu s\xE1m po zav\xEDra\u010Dce. Na slo\u017Eit\u011Bj\u0161\xED v\u011Bci m\xE1m servisn\xED manu\xE1ly."
      guestReply: "Rozumn\xE9. \u010Clov\u011Bk se v t\xE9hle bran\u017Ei u\u010D\xED doslova cel\xFD \u017Eivot."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Opravit? T\u011Bm ma\u0161in\xE1m rozum\xEDm l\xEDp ne\u017E sob\u011B! Po zav\xEDra\u010Dce to d\xE1m do kupy i poslepu!"
      guestReply: "Siln\xE1 slova! D\xE1m ti ur\u010Dit\u011B v\u011Bd\u011Bt, a\u017E se mi doma pokaz\xED star\xE1 televize."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Kdyby ti na tom star\xE9m Generalu sho\u0159el sp\xEDnan\xFD zdroj, v\xED\u0161 v\u016Fbec, co s t\xEDm?"
    negative:
      text: "Zat\xEDm jsem jen \u010Distil tla\u010D\xEDtka... kdyby vylet\u011Bl zdroj, musel bych to zav\u0159\xEDt."
      guestReply: "Za\u010Dni se vzd\u011Bl\xE1vat. Nem\u016F\u017Ee\u0161 s ka\u017Edou sp\xE1lenou pojistkou volat servis."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "M\xE1m ve skladu dva n\xE1hradn\xED moduly a prom\u011B\u0159it nap\u011Bt\xED multimetrem zvl\xE1d\xE1m."
      guestReply: "Hlavn\u011B kdy\u017E v\xED\u0161, kde je f\xE1ze. Technick\xE1 obez\u0159etnost ti nechyb\xED."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Jasn\u011B \u017Ee v\xEDm! P\xE1jka, fortel a tyhle star\xFD veter\xE1ni zase \u0161lapou jako hodinky!"
      guestReply: "Tzv. \xFAdr\u017Eba na \u010Desk\xFD zp\u016Fsob! Dokud to funguje bez po\u017E\xE1ru, nebudu se h\xE1dat."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Co star\xE9 CRT monitory na MuckManovi? Ty vysokonap\u011B\u0165ov\xE9 trafa b\xFDvaj\xED nebezpe\u010Dn\xE9."
    negative:
      text: "D\u011Bda mi p\u0159ed nimi kladl respekt, tak se k nim rad\u0161i v\u016Fbec nep\u0159ibli\u017Euji..."
      guestReply: "Respekt je fajn, ale bez otev\u0159en\xED bedny monitor nese\u0159\xEDd\xED\u0161."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "V\xEDm p\u0159esn\u011B, jak vyb\xEDt anodu, ne\u017E na desku s\xE1hnu. Bezpe\u010Dnost nepodce\u0148uji."
      guestReply: "To r\xE1d sly\u0161\xEDm. Z vysok\xE9ho nap\u011Bt\xED m\u011Bl i tv\u016Fj d\u011Bda v\u017Edycky posv\xE1tnou hr\u016Fzu."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Tyhle star\xE9 lampy pot\u0159ebuj\xED jen l\xE1sku, trp\u011Blivost a pevnou ruku! Oboj\xED m\xE1m!"
      guestReply: "P\u0159\xEDstup m\xE1\u0161 spr\xE1vn\xFD. V\u011B\u0159 mi, \u017Ee ty stroje tvou energii a p\xE9\u010Di poznaj\xED."
      socialBatteryChange: -1
      money: 10
