%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 300f5844559acab45b0a9637e17f2a48, type: 3}
  m_Name: mladistvy
  m_EditorClassIdentifier: Assembly-CSharp::DialogGroup
  groupName: 
  leaveChanceOnNegative: 0.5
  entries:
  - guestPhrase: "Kdy\u017E m\xE1m 10 l\xEDstk\u016F, co za to dostanu? D\xE1 mi to aspo\u0148 to aut\xED\u010Dko?"
    negative:
      text: "Ne, to aut\xED\u010Dko je bohu\u017Eel mnohem dra\u017E\u0161\xED... za deset ti m\u016F\u017Eu d\xE1t jen tady gumu."
      guestReply: "Aha... tak j\xE1 si teda vezmu tu gumu. \u0160koda, \u017Ee na nic lep\u0161\xEDho nem\xE1m..."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Deset l\xEDstk\u016F je na l\xEDz\xE1tko nebo hops\xEDk z t\xE9hle krabi\u010Dky. Aut\xED\u010Dko je a\u017E za sto l\xEDstk\u016F."
      guestReply: "Sto? To je hrozn\u011B moc... Tak mi dejte toho hops\xEDka, a\u0165 aspo\u0148 n\u011Bco m\xE1m."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Deset l\xEDstk\u016F? K\xE1mo, to jsi teprve na za\u010D\xE1tku! Schovej je a to auto bude brzo tvoje!"
      guestReply: "Tak jo! Jdu hr\xE1t d\xE1l a to auto stoprocentn\u011B vyhraju! D\xEDky za povzbuzen\xED!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Kolik l\xEDstk\u016F mus\xEDm vyhr\xE1t na toho ob\u0159\xEDho ply\u0161ov\xE9ho medv\u011Bda ve vitr\xEDn\u011B?"
    negative:
      text: "To nesta\u010D\xED, ten je stra\u0161n\u011B drah\xFD. Vezmi si zat\xEDm bonbon, na medv\u011Bda neu\u0161et\u0159\xED\u0161."
      guestReply: "Tak j\xE1 si to rad\u0161i schov\xE1m do pen\u011B\u017Eenky, a\u0165 m\xE1m p\u0159\xED\u0161t\u011B v\xEDc. D\xEDky."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Velk\xFD medv\u011Bd je za p\u011Bt set l\xEDstk\u016F. M\u016F\u017Ee\u0161 si l\xEDstky st\u0159\xE1dat u n\xE1s na v\u011Brnostn\xED \xFA\u010Det."
      guestReply: "Hm, tak j\xE1 si vyberu tamtoho mal\xE9ho plastov\xE9ho pavouka. D\u011Bkuju."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Medv\u011Bd je sice za p\u011Bt set, ale kdy\u017E bude\u0161 \u0161et\u0159it a tr\xE9novat, odnese\u0161 si ho jak kr\xE1l!"
      guestReply: "Fakt?! Tak to si ty l\xEDstky schov\xE1m do pen\u011B\u017Eenky a budu \u0161et\u0159it na toho ob\u0159\xEDho medv\u011Bda!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Kde v hern\u011B pad\xE1 nejv\xEDc l\xEDstk\u016F? Cht\u011Bl bych si dneska odn\xE9st aspo\u0148 n\u011Bjakou hra\u010Dku."
    negative:
      text: "Mrz\xED m\u011B to, ale na v\u011Bt\u0161in\u011B her to moc nepad\xE1... vem si rad\u0161i tady l\xEDz\xE1tko a nezlob."
      guestReply: "Kdy\u017E to na auto nesta\u010D\xED, tak mi dejte aspo\u0148 to l\xEDz\xE1tko... Ach jo."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Z\xE1le\u017E\xED na \u0161ikovnosti. Hodn\u011B l\xEDstk\u016F d\xE1v\xE1 basketbalov\xFD automat a Dance Monkey."
      guestReply: "Budu si to \u0161et\u0159it, a\u0165 m\xE1m p\u0159\xED\u0161t\u011B na n\u011Bco po\u0159\xE1dn\xE9ho. D\xEDky za vysv\u011Btlen\xED."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Hele, d\xE1m ti tajnej tip \u2013 na Flappy Pigeon to p\u0159i dobr\xE9m kombu sype nejv\xEDc!"
      guestReply: "Hust\xFD! Jdu hned vyzkou\u0161et Flappy Pigeon, d\xEDky moc za radu!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Pane... jak se d\u011Bl\xE1 to velk\xFD kombo v Petrisu? Nem\u016F\u017Eu porazit br\xE1chu."
    negative:
      text: "J\xE1 popravd\u011B v\u016Fbec nev\xEDm, Petris nen\xED moc m\u016Fj styl a moc mi to nejde..."
      guestReply: "Aha... Tak nevad\xED, jdu to zkusit n\u011Bjak doklikat s\xE1m podle sebe."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "\u010C\xEDm v\xEDce \u0159ad nar\xE1z vyma\u017Ee\u0161, t\xEDm vy\u0161\u0161\xED kombo. Nejlep\u0161\xED je mazat \u010Dty\u0159i \u0159ady sou\u010Dasn\u011B."
      guestReply: "\u010Cty\u0159i \u0159ady nar\xE1z pro maxim\xE1ln\xED sk\xF3re... Super, zkus\xEDm to takhle poskl\xE1dat!"
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Br\xE1cha d\u011Bl\xE1 machry? Stav\u011Bj v\u011B\u017E k jedn\xE9 stran\u011B a nech si \u0161achtu na dlouhou ty\u010Dku!"
      guestReply: "Jasn\u011B, nechat si \u0161achtu na dlouhou ty\u010Dku! Jdu ho hned zkusit sest\u0159elit z prvn\xEDho m\xEDsta!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Jak m\xE1m na\u010Dasovat skok ve Flappy Pigeon, abych nenarazil hned do prvn\xED trubky?"
    negative:
      text: "Mus\xED\u0161 prost\u011B n\u011Bjak ma\u010Dkat to tla\u010D\xEDtko... v\xEDc ti k tomu ne\u0159eknu, je to moc t\u011B\u017Ek\xE9."
      guestReply: "To mi \u0159\xEDkaj\xED v\u0161ichni dosp\u011Bl\xED, ale nikdo mi to po\u0159\xE1dn\u011B nevysv\u011Btl\xED... Tak d\xEDk no."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Chce to rytmus. Zm\xE1\u010Dkni tla\u010D\xEDtko t\u011Bsn\u011B p\u0159ed t\xEDm, ne\u017E pt\xE1k za\u010Dne klesat pod \xFArove\u0148 hrany."
      guestReply: "Pravda, ten n\xE1hled jsem v\u016Fbec nesledoval. Zkus\xEDm se na n\u011Bj zam\u011B\u0159it."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Je to o rytmu a o tom d\xEDvat se na dal\u0161\xED p\u0159ek\xE1\u017Eku dop\u0159edu! Mysli na dva skoky nap\u0159ed!"
      guestReply: "Myslet dva tahy dop\u0159edu... Jdu na to! Mockr\xE1t v\xE1m d\u011Bkuju, pane za pultem!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Pro\u010D mi na Miami Drive auto v zat\xE1\u010Dce poka\u017Ed\xE9 dostane smyk a naraz\xED do svodidel?"
    negative:
      text: "Zkus prost\u011B rychle to\u010Dit volantem... v tomhle ti moc neporad\xEDm, mn\u011B to taky nejde."
      guestReply: "To u\u017E d\u011Bl\xE1m a akor\xE1t jsem hned prohr\xE1l... Ale tak d\xEDky i tak."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "P\u0159ed zat\xE1\u010Dkou mus\xED\u0161 na vte\u0159inu pustit plyn, zato\u010Dit a teprve na v\xFDjezdu zase se\u0161l\xE1pnout ped\xE1l."
      guestReply: "P\u0159i\u0161lo mi to slo\u017Eit\xE9, ale dobr\xE1, zkus\xEDm v\xEDc ma\u010Dkat to\u010D\xEDc\xED tla\u010D\xEDtko."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Kombo? Na zbrklost zapome\u0148! Trp\u011Blivost d\u011Bl\xE1 kr\xE1le, do zat\xE1\u010Dky brzd\xED jen ti, co cht\u011Bj\xED vyhr\xE1t!"
      guestReply: "J\xF3\xF3\xF3! Trp\u011Blivost a klidn\xE1 hra, to br\xE1cha neum\xED! Jdu ho zni\u010Dit jeho vlastn\xED zbrklost\xED!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "M\u016F\u017Eu si u v\xE1s za pultem nechat batoh, ne\u017E dohraju?"
    negative:
      text: "My to tu sice moc ned\u011Bl\xE1me, j\xE1 za to neru\u010D\xEDm... ale tak si ho dej t\xE1mhle do kouta."
      guestReply: "D\u011Bkuju... Snad mi ho tam nikdo nevezme. Hned jak dohraju, jsem zp\xE1tky."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Dob\u0159e, polo\u017E si batoh tady vedle pultu. Ale nezapome\u0148 si ho p\u0159i odchodu."
      guestReply: "Nezapomenu, slibuju! Nech\xE1m ho tu a jdu hr\xE1t."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Jas\u0148a\u010Dka! Tady za pultem je to hl\xEDdan\xFD l\xEDp ne\u017E v bance! B\u011B\u017E pa\u0159it a bu\u010F v klidu!"
      guestReply: "To hrozn\u011B r\xE1d sly\u0161\xEDm! Jdu do toho naplno, d\xEDky moc!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Pane, m\u016F\u017Eu si tady vedle kasy odlo\u017Eit bundu? U t\u011Bch automat\u016F je stra\u0161n\xE9 horko."
    negative:
      text: "Asi jo... ale hl\xEDd\xE1m hlavn\u011B tr\u017Ebu a kasu, tak\u017Ee za ciz\xED v\u011Bci neru\u010D\xEDm."
      guestReply: "Nevad\xED, m\xE1m tam stejn\u011B jenom se\u0161ity do \u0161koly. D\u011Bkuju za ochotu."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Pov\u011Bs si ji tady na v\u011B\u0161\xE1k vedle dve\u0159\xED, a\u0165 se ti nepovaluje po zemi."
      guestReply: "Jenom na dv\u011B hry na Ping automatu, za deset minut si ho zase vyzvednu."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Ho\u010F ji sem za kasu! Aspo\u0148 ti nebude p\u0159ek\xE1\u017Eet v rychl\xFDch pohybech u tla\u010D\xEDtek!"
      guestReply: "Haha, m\xE1m tam jen u\u010Debnice matiky, ty jsou mo\u017En\xE1 t\u011B\u017E\u0161\xED ne\u017E cihly! D\xEDky!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Mohl bych si za pult op\u0159\xEDt kolob\u011B\u017Eku? Venku pr\u0161\xED a boj\xEDm se, \u017Ee mi ji n\u011Bkdo vezme."
    negative:
      text: "Zaru\u010Dit nic nemohu, pult m\xE1m pln\xFD pap\xEDr\u016F... ale tak budi\u017E, ho\u010F to tam."
      guestReply: "Jste hodn\xFD, d\xEDky moc... Snad v\xE1m tam nebude p\u0159ek\xE1\u017Eet."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Postav ji za vnit\u0159n\xED hranu pultu, a\u0165 o ni nikdo v uli\u010Dce nezakopne."
      guestReply: "Nem\xE1m v n\u011Bm nic drah\xE9ho, jen sva\u010Dinu a pen\xE1l. Je\u0161t\u011B jednou d\u011Bkuju."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "D\xE1m ti na ni pozor, ale slib mi, \u017Ee nahraje\u0161 high-score na Generalu! Plat\xED?!"
      guestReply: "Tak to je par\xE1dn\xED v\xFDzva! Jdu tam padnout rekord a batoh je u v\xE1s v bezpe\u010D\xED!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Mn\u011B to v\u016Fbec nejde, neud\u011Bl\xE1te mi tenhle level pros\xED\xEDm?"
    negative:
      text: "J\xE1 te\u010F od pultu nem\u016F\u017Eu odej\xEDt, promi\u0148... mus\xEDm tady hl\xEDdat."
      guestReply: "Ach jo... Tak j\xE1 to teda je\u0161t\u011B zkus\xEDm n\u011Bjak protr\xE1pit s\xE1m."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Nemohu hr\xE1t za tebe, to by nebylo f\xE9r. Zkus sledovat pohyby nep\u0159\xE1tel."
      guestReply: "Tak dob\u0159e... D\xE1m do toho v\u0161echno. Tohle prost\u011B mus\xEDm zvl\xE1dnout s\xE1m."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Ud\u011Blat level za tebe? Z toho bys nem\u011Bl radost! Kryj se za bednami a v\u011B\u0159 si!"
      guestReply: "Kr\xFDt se za bednami? To jsem je\u0161t\u011B nezkou\u0161el! Jdu to omrknout, j\xE1 ho ud\u011Bl\xE1m!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Ten boss na konci Generalu m\u011B poka\u017Ed\xE9 zabije na dv\u011B r\xE1ny! Nem\u016F\u017Eete ho sejmout za m\u011B?"
    negative:
      text: "Nezlob se, ale j\xE1 tu hru s\xE1m v\u016Fbec neum\xEDm a pokazil bych ti to je\u0161t\u011B v\xEDc..."
      guestReply: "Kdy\u017E to neum\xEDte ani vy, tak to je asi fakt nemo\u017En\xFD level... D\xEDky i tak."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Kdy\u017E to p\u0159ejdu j\xE1, nic se nenau\u010D\xED\u0161. Zkus to znovu, z kasy na tebe mrknu a napov\xEDm."
      guestReply: "Tak fajn, budu se na v\xE1s d\xEDvat, jestli mi rukou uk\xE1\u017Eete spr\xE1vn\xFD sm\u011Br!"
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Kdybych to ud\u011Blal j\xE1, ochudil bych t\u011B o pocit v\xEDt\u011Bzstv\xED! Uka\u017E t\xE9 ma\u0161in\u011B, kdo je tu p\xE1n!"
      guestReply: "Tomu \u0159\xEDk\xE1m motivace! M\xE1te pravdu, chci ten pocit v\xEDt\u011Bzstv\xED pro sebe! Jdu na to!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Mn\u011B ten m\xED\u010Dek v Pingu poka\u017Ed\xE9 propadne mezi p\xE1lkami, neuk\xE1\u017Eete mi ten grif?"
    negative:
      text: "J\xE1 se v t\u011Bch hr\xE1ch taky ztr\xE1c\xEDm... zkus si zahr\xE1t rad\u0161i n\u011Bco leh\u010D\xEDho."
      guestReply: "Asi m\xE1te pravdu... Rad\u0161i to vzd\xE1m a zkus\xEDm vedlej\u0161\xED Flappy Pigeon."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "P\xE1lkou nepohybuj zb\u011Bsile, dr\u017E st\u0159ed stolu a reaguj a\u017E na odraz od mantinelu."
      guestReply: "Ch\xE1pu pravidla... Zkus\xEDm je\u0161t\u011B jeden pokus a uvid\xEDm."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "P\u0159ece se nevzd\xE1\u0161 po p\xE1r pokusech! Ka\u017Ed\xFD \u0161ampion musel stokr\xE1t padnout! B\u011B\u017E vyhr\xE1t!"
      guestReply: "Hust\xFD! Ur\u010Dit\u011B z toho neute\u010Du, jdu \u0161plhat na vrchol tabulky!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Pane, v automatu Grab mi vis\xED ply\u0161\xE1k t\u011Bsn\u011B nad d\xEDrou a nespadl! M\u016F\u017Eete do toho zvenku bouchnout?"
    negative:
      text: "J\xE1 s t\xEDm zpoza pultu nic nesvedu, ty automaty jsou nastaven\xE9 tak, aby to padalo zp\xE1tky..."
      guestReply: "Tak\u017Ee je to podvod?! No nic, hod\xEDm tam je\u0161t\u011B jeden \u017Eeton a uvid\xEDm."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Do sk\u0159\xEDn\u011B automatu se bouchat nesm\xED, ot\u0159esov\xE9 \u010Didlo by zablokovalo v\xFDdej. Uprav \xFAhel."
      guestReply: "Aha, tak do toho bouchat nebudu. Zkus\xEDm to je\u0161t\u011B p\xE1kou."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Kopance do skla ne! Ale zami\u0159 ten h\xE1k za rameno ply\u0161\xE1ka, tam m\xE1 t\u011B\u017Ei\u0161t\u011B! Vyt\xE1hne\u0161 ho!"
      guestReply: "Fakt za rameno?! Jdu to hned vyzkou\u0161et s dal\u0161\xEDm \u017Eetonem, ten medv\u011Bd bude m\u016Fj!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "V automatu Gumball Machine se zasekla \u017Ev\xFDka\u010Dka v oto\u010Dn\xE9m kole\u010Dku, m\u016F\u017Eete s t\xEDm zat\u0159\xE1st?"
    negative:
      text: "J\xE1 s t\xEDm nic nesvedu... kdybych do toho \u0161el kopnout, rozbiju sklo a musel bych to platit."
      guestReply: "Tak to jste mi moc nepomohl... Zkus\xEDm tam hodit je\u0161t\u011B \u017Eeton s\xE1m."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Net\u0159es s t\xEDm, pooto\u010D kli\u010Dkou je\u0161t\u011B o kousek zp\xE1tky a dop\u0159edu, z\xE1padka povol\xED."
      guestReply: "Rozum\xEDm, budu hr\xE1t podle pravidel. Snad ten h\xE1k tentokr\xE1t povol\xED ve spr\xE1vnou chv\xEDli."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Bouch\xE1n\xED je pro amat\xE9ry! Jemn\u011B pooto\u010D mechanismem a uka\u017E cit v prstech!"
      guestReply: "Pevn\xE1 ruka chirurga... Dobr\xE1 v\xFDzva! Po\u010Dk\xE1m, a\u017E se h\xE1k uklidn\xED, a jdu na n\u011Bj!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Ten automat na l\xEDstky mi vytiskl jen p\u016Flku prou\u017Eku a zbytek se zasekl uvnit\u0159!"
    negative:
      text: "Bohu\u017Eel nic neud\u011Bl\xE1m... ty tisk\xE1rny jsou star\xE9 a po\u0159\xE1d se v nich trh\xE1 pap\xEDr."
      guestReply: "To je \u0161koda... ale je\u0161t\u011B to jednou zkus\xEDm, ne\u017E p\u016Fjdu dom\u016F."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Po\u010Dkej, zkontroluji stav po\u010D\xEDtadla ze syst\xE9mu a vytisknu ti n\xE1hradn\xED kup\xF3n z kasy."
      guestReply: "N\xE1hradn\xED pokus beru, d\u011Bkuji. Snad se mi to te\u010F povede l\xEDp."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "\u017D\xE1dn\xFD strach! Tady m\xE1\u0161 rovnou cel\xFD p\xE1s l\xEDstk\u016F za state\u010Dnost a b\u011B\u017E drtit dal\u0161\xED hru!"
      guestReply: "J\xE9\xE9\xE9, d\u011Bkuju moc za \u017Eeton! Tentokr\xE1t ho stoprocentn\u011B naberu do d\xEDry!"
      socialBatteryChange: -1
      money: 10
