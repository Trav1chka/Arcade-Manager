%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 300f5844559acab45b0a9637e17f2a48, type: 3}
  m_Name: try_hard
  m_EditorClassIdentifier: Assembly-CSharp::DialogGroup
  groupName: 
  leaveChanceOnNegative: 0.5
  entries:
  - guestPhrase: "Tla\u010D\xEDtko 'A' m\xE1 zpo\u017Ed\u011Bn\xED minim\xE1ln\u011B 2 milisekundy, m\u016F\u017Eete to hned vy\u010Distit?"
    negative:
      text: "Omlouv\xE1m se! Hned to zkus\xEDm zpoza pultu ot\u0159\xEDt had\u0159\xEDkem, snad to aspo\u0148 trochu pom\u016F\u017Ee..."
      guestReply: "Had\u0159\xEDkem zvenku?! Tla\u010D\xEDtko m\xE1 odpor na mikrosp\xEDna\u010Di uvnit\u0159! Na tomhle se ned\xE1 tr\xE9novat."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Zpo\u017Ed\u011Bn\xED dvou milisekund je u star\u0161\xEDch desek v b\u011B\u017En\xE9 toleranci. Po \u0161icht\u011B to projdu."
      guestReply: "V toleranci?! No to je \xFArove\u0148... aspo\u0148 to po zav\xEDra\u010Dce po\u0159\xE1dn\u011B prost\u0159\xEDkn\u011Bte kontaktolem."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Dv\u011B milisekundy? Vzhledem k tomu, jak to \u010Dist\xEDm, hardwarem to nen\xED. P\u0159idej v reflexech!"
      guestReply: "Moje reflexy?! N\xE1hodou pat\u0159\xEDm do top stovky! J\xE1 ti uk\xE1\u017Eu, \u017Ee to d\xE1m i tak!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Joystick na Generalu m\xE1 moc velkou mrtvou z\xF3nu, v diagon\xE1l\xE1ch to v\u016Fbec nesn\xEDm\xE1 komba!"
    negative:
      text: "J\xE1 to popravd\u011B moc nepozn\xE1m... jestli ti to vad\xED, rad\u0161i ti vr\xE1t\xEDm \u017Eeton a nezlob se."
      guestReply: "Vr\xE1tit \u017Eeton?! Vy tomu hardwaru v\u016Fbec nerozum\xEDte, na tomhle se turnaj vyhr\xE1t ned\xE1."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Mikrosp\xEDna\u010De maj\xED sv\xE9 mechanick\xE9 limity. Zpo\u017Ed\u011Bn\xED je dan\xE9 konstrukc\xED star\xE9 desky."
      guestReply: "Mechanick\xE9 limity... Fajn, aspo\u0148 \u017Ee v\xEDte, o \u010Dem mluv\xEDte. Zkus\xEDm to n\u011Bjak vykompenzovat."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Tohle je ark\xE1da, ne NASA! Ty sm\u011Bry mus\xED\u0161 po\u0159\xE1dn\u011B za\u0159\xEDznout, ne joystick jen hladit!"
      guestReply: "N\xE1hodou tenhle lehk\xFD grip pou\u017E\xEDvaj\xED prof\xEDci v Asii! Ale fajn, j\xE1 ti p\u0159edvedu tlak!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Obrazovka na automatu Ping m\xE1 p\u0159\xED\u0161ern\xFD ghosting! M\xED\u010Dek se v rychlosti rozmaz\xE1v\xE1!"
    negative:
      text: "Asi u\u017E je ta obrazovka prost\u011B star\xE1... nechce\u0161 si j\xEDt rad\u0161i zahr\xE1t n\u011Bco jin\xE9ho?"
      guestReply: "Tady se seri\xF3zn\xED tr\xE9nink provozovat ned\xE1... No nic, jdu d\xE1t aspo\u0148 jednu hru."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Origin\xE1ln\xED CRT obrazovky maj\xED ur\u010Ditou setrva\u010Dnost fosforu. V\xFDm\u011Bnu pl\xE1nujeme za m\u011Bs\xEDc."
      guestReply: "Fajn, ale zapi\u0161te si to velk\xFDm p\xEDsmem. Ztratil jsem kv\u016Fli tomu perfektn\xED kombo."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Jestli t\u011B z m\xEDry vyvede setrva\u010Dnost fosforu, nem\xE1\u0161 na tuhle veter\xE1nskou ligu skill!"
      guestReply: "Bre\u010Det?! J\xE1 ti uk\xE1\u017Eu, \u017Ee toho bosse rozsek\xE1m na kousky i s touhle odezvou! Uhni z v\xFDhledu!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Co\u017Ee, kdy \u017Ee zav\xEDr\xE1te?! To nest\xEDh\xE1m dohr\xE1t tu hru t\u0159icetkr\xE1t, ale jen dvacetosmkr\xE1t!"
    negative:
      text: "Tak dob\u0159e... ale pros\xEDm, fakt jenom p\u011Bt minut, abych je\u0161t\u011B stihl autobus."
      guestReply: "P\u011Bt minut mi sotva sta\u010D\xED na rozeh\u0159\xE1t\xED! Jdu k ma\u0161in\u011B a te\u010F na m\u011B nemluvte!"
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Zav\xEDrac\xED doba plat\xED pro ka\u017Ed\xE9ho bez v\xFDjimky. Dohraj tenhle pokus a pokra\u010Duj z\xEDtra."
      guestReply: "Z\xEDtra?! V\xEDte, jak dlouho trv\xE1 dostat se zp\xE1tky do tempa? ...Fajn, jdu na tenhle run."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Tohle je ta prav\xE1 prov\u011Brka mistra! Hraje\u0161 proti bossovi i proti mn\u011B, do t\u0159\xED minut let\xED\u0161!"
      guestReply: "T\u0159i minuty?! Challenge accepted! Spus\u0165te neviditeln\xE9 stopky, jdu na speedrun!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "M\xE1m rozjet\xFD perfect run na Petrisu a vy chcete za deset minut zhasnout celou hernu?!"
    negative:
      text: "U\u017E bych m\u011Bl v\xE1\u017En\u011B j\xEDt dom\u016F... ale nech\xE1m ti ten jeden automat je\u0161t\u011B chvilku zapnut\xFD..."
      guestReply: "No sl\xE1va, aspo\u0148 n\u011Bjak\xFD respekt k progamingov\xE9mu tr\xE9ninku. Jdu hr\xE1t a bu\u010Fte potichu."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Za deset minut se centr\xE1ln\u011B vyp\xEDn\xE1 proud pro celou sekci."
      guestReply: "Fajn, tenhle run vezmu na maxim\xE1ln\xED risk. Snad mi ten zbytek \u010Dasu bude sta\u010Dit."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Deset padla, zhas\xEDn\xE1m sv\u011Btla! M\xE1\u0161 p\u0159esn\u011B jeden \u017Eivot na to ho dod\u011Blat potm\u011B!"
      guestReply: "Hr\xE1t bossfight potm\u011B?! To je absolutn\u011B \u0161\xEDlen\xFD... ale beru to! Sledujte tenhle clutch!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Pot\u0159ebuju je\u0161t\u011B aspo\u0148 p\u016Fl hodiny na optim\xE1ln\xED grind, jinak mi spadne pr\u016Fm\u011Brn\xE9 APM!"
    negative:
      text: "Nerad bych ti kazil hru... tak j\xE1 tady za kasou je\u0161t\u011B chv\xEDli po\u010Dk\xE1m p\u0159es\u010Das."
      guestReply: "Tak tam ti\u0161e se\u010Fte a ned\u011Blejte r\xE1mus s t\u011Bma mincema, pot\u0159ebuju se soust\u0159edit!"
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "\u010Casov\xFD harmonogram neposunu. Pokud jsi hru nedokon\u010Dil, zrychli postup."
      guestReply: "P\u0159\xED\u0161t\u011B budu muset za\u010D\xEDt o p\u016Fl hodiny d\u0159\xEDv. \u0160koda takto rozjet\xE9ho tr\xE9ninkov\xE9ho bloku."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Dvac\xE1t\xFD osm\xFD pokus mus\xED b\xFDt ten v\xEDt\u011Bzn\xFD, jinak na t\xE9 ma\u0161in\u011B nem\xE1\u0161 co d\u011Blat!"
      guestReply: "\u017De jsem tlu\u010Dhuba?! Te\u010F ten dvac\xE1t\xFD osm\xFD pokus zahraju tak \u010Dist\u011B, \u017Ee v\xE1m z toho spadne brada!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "N\u011Bkdo mi p\u0159emazal m\u016Fj 'save' na tomhle automatu! Kdo tu byl p\u0159ede mnou?!"
    negative:
      text: "J\xE1 opravdu nev\xEDm, nest\xE1l jsem u toho... zpoza pultu nevid\xEDm na ka\u017Ed\xFD displej."
      guestReply: "Kdybyste d\xE1val pozor a d\u011Blal svoji pr\xE1ci, tak se to nestane! Jdu to nahr\xE1t znova."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Tohle je ve\u0159ejn\xE1 herna. Automaty zaznamen\xE1vaj\xED sk\xF3re v\u0161ech, prvenstv\xED negarantuji."
      guestReply: "Tohle je naposled, co jsem se spol\xE9hal na m\xEDstn\xED \u017Eeb\u0159\xED\u010Dek. P\u0159\xED\u0161t\u011B si ten displej vyfot\xEDm."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Kdo to p\u0159emazal? N\u011Bkdo s lep\u0161\xEDm sk\xF3re a rychlej\u0161\xEDma rukama! Zaho\u010F slzy a vem si tr\u016Fn!"
      guestReply: "Lep\u0161\xED ne\u017E j\xE1?! M\u011Bl jsem tam absolutn\xED sk\xF3re! J\xE1 jim uk\xE1\u017Eu, rozbiju tu tabulku na padr\u0165!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Pro\u010D se po v\xFDpadku proudu smazala cel\xE1 tabulka lok\xE1ln\xEDch rekord\u016F na MuckManovi?!"
    negative:
      text: "Mo\u017En\xE1 se vybila baterie na desce... moc se omlouv\xE1m, star\xE1 data neum\xEDm obnovit."
      guestReply: "Vy tu nem\xE1te ani z\xE1lo\u017En\xED nap\xE1jen\xED CMOS?! To si d\u011Bl\xE1te legraci, takov\xFD amat\xE9rismus!"
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "P\u0159i p\u0159ep\u011Bt\xED se star\xE9 SRAM moduly resetuj\xED do tov\xE1rn\xEDho nastaven\xED. Z\xE1znamy jsou pry\u010D."
      guestReply: "Jasn\u011B, logika pam\u011Bti. Ned\xE1 se nic d\u011Blat, jdu tam nas\xE1zet je\u0161t\u011B vy\u0161\u0161\xED hodnotu."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Tohle je retro ark\xE1da, \u017E\xE1dn\xE1 dom\xE1c\xED konzole s ukl\xE1d\xE1n\xEDm! Tady se hraje od nuly na skill!"
      guestReply: "Vlastn\u011B m\xE1te pravdu... Prav\xFD hardcore z\xE1\u017Eitek. Jdu do toho znovu a p\u0159ep\xED\u0161u v\u0161echny!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "N\u011Bkdo mi p\u0159epsal m\u016Fj nick 'X_SNIPER_X' na prvn\xEDm m\xEDst\u011B u Invaders of Personal Space!"
    negative:
      text: "Pros\xEDm, nek\u0159i\u010Dte tu tolik... j\xE1 za pam\u011B\u0165 automat\u016F neru\u010D\xEDm, nedok\xE1\u017Eu hl\xEDdat reset."
      guestReply: "Kdy\u017E za to neru\u010D\xEDte, tak co tady d\u011Bl\xE1te?! Jdu si ten rekord nahr\xE1t znova s\xE1m."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Byl tu p\u0159ed tebou hr\xE1\u010D s vy\u0161\u0161\xEDm sk\xF3re. Bodov\xFD v\xFDsledek v syst\xE9mu plat\xED."
      guestReply: "Platn\xE9, ale ne nep\u0159ekonateln\xE9. Jdu si vz\xEDt \u017Eetony a zlom\xEDm to."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "P\u0159emazal? Sp\xED\u0161 t\u011B n\u011Bkdo f\xE9rov\u011B rozdrtil a ty si to nechce\u0161 p\u0159iznat! Doka\u017E, co um\xED\u0161!"
      guestReply: "M\u011B nikdo nerozdrtil, to byla n\xE1hoda! Ustupte, jdu tam nas\xE1zet nep\u0159ekonateln\xFD rekord!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Nesahejte mi na ten automat Miami Drive, m\xE1m sv\u016Fj fyzik\xE1ln\xED syst\xE9m, jak s n\xEDm cloumat v zat\xE1\u010Dk\xE1ch!"
    negative:
      text: "Hlavn\u011B s t\xEDm tak net\u0159es... ty nohy automatu jsou drah\xE9 a j\xE1 bych to platil ze sv\xE9ho."
      guestReply: "Ostatn\xED to neum\xED, j\xE1 v\xEDm p\u0159esn\u011B, kde to m\xE1 t\u011B\u017Ei\u0161t\u011B! Jdu to projet norm\xE1ln\u011B."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Cloumat se strojem je zak\xE1z\xE1no provozn\xEDm \u0159\xE1dem, senzory vyhodnot\xED chybu."
      guestReply: "Ten senzor je zbyte\u010Dn\u011B citliv\xFD. Ale dob\u0159e, nebudu s t\xEDm h\xE1zet, a\u0165 nep\u0159ijdu o kredit."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Fyzik\xE1ln\xED syst\xE9m?! Lomcuje\u0161 s t\xEDm jak s m\xEDcha\u010Dkou! Hraj volantem, nebo let\xED\u0161!"
      guestReply: "Dob\u0159e, dob\u0159e, klid! Hraju \u010Dist\u011B, jenom se neroz\u010Dilujte! Zvl\xE1dnu to i bez cloum\xE1n\xED!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Pro\u010D m\u011B napom\xEDn\xE1te na Dance Monkey? Dup\xE1n\xED plnou vahou je jedin\xFD zp\u016Fsob, jak registrovat \u0161ipky!"
    negative:
      text: "Tak j\xE1 na to rad\u0161i nebudu sahat... jen se boj\xEDm, aby se podstavec neutrhl."
      guestReply: "D\u011Bda to postavil k\u0159iv\u011B, j\xE1 tomu stroji jen pom\xE1h\xE1m k lep\u0161\xED dynamice! Jdu do zat\xE1\u010Dky."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Tlakov\xE9 senzory sn\xEDmaj\xED lehk\xFD do\u0161lap. Dup\xE1n\xED v kanad\xE1ch po\u0161kozuje piezoelektrick\xE9 sn\xEDma\u010De."
      guestReply: "Fajn, polo\u017E\xEDm to zp\xE1tky. Budu se dr\u017Eet jen volantu a ped\xE1l\u016F."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Tv\u016Fj 'fyzik\xE1ln\xED syst\xE9m' ni\u010D\xED podlahu! Uka\u017E \u010Distou stopu volantem, jestli nejsi srab!"
      guestReply: "J\xE1 a srab?! Sleduj tu stopu v apexu, vyseknu ti drift i bez pohnut\xED r\xE1mu!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Kdy\u017E ten Ping automat nadzvednu o centimetr, m\xED\u010Dek se odraz\xED v ne\u0159e\u0161iteln\xE9m \xFAhlu pro protihr\xE1\u010De!"
    negative:
      text: "Jenom do toho pros\xEDm moc netlu\u010Dte... nerad bych, aby se to rozbilo."
      guestReply: "Ostatn\xED nemaj\xED m\u016Fj kinetick\xFD odhad. Vy tomu prost\u011B nerozum\xEDte, jdu z\xE1vodit."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Jak\xE9koliv nakl\xE1n\u011Bn\xED stroje spou\u0161t\xED n\xE1klonov\xFD sp\xEDna\u010D TILT a okam\u017Eit\u011B ru\u0161\xED hru."
      guestReply: "Rozum\xEDm, budu hr\xE1t pouze p\u0159es ped\xE1l a volant. Mechanika m\xE1 sv\xE9 meze."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Cloumat s kabinetem um\xED ka\u017Edej! Skute\u010Dn\xFD z\xE1vodn\xEDk vyhr\xE1v\xE1 prac\xED s plynem!"
      guestReply: "Zoufalec?! Te\u010F ti uk\xE1\u017Eu \u010Distou j\xEDzdu bez jedin\xE9 kolize! Sleduj tachometr!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "M\u016F\u017Eete ztlumit automat vedle m\xE9ho? Hrozn\u011B m\u011B to ru\u0161\xED v soust\u0159ed\u011Bn\xED!"
    negative:
      text: "J\xE9, omlouv\xE1m se! Hned to zkus\xEDm zti\u0161it, asi jsem ten zvuk r\xE1no p\u0159ep\xEDskl..."
      guestReply: "No proto! Hr\xE1\u010D pot\u0159ebuje sly\u0161et frame-perfect audio stopy sv\xE9 hry! Jdu do bossfightu."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Hlasitost automat\u016F je nastavena centr\xE1ln\u011B na provozn\xED \xFArove\u0148 herny."
      guestReply: "Ch\xE1pu, standardn\xED akustika podniku. P\u0159\xED\u0161t\u011B si vezmu vlastn\xED sluch\xE1tka, jdu hr\xE1t."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Ztlumit?! K\xE1mo, tohle je ark\xE1dovna, ne knihovna! Progamer nevn\xEDm\xE1 krav\xE1l, zrychli prsty!"
      guestReply: "Nenechat se rozhodit... Ty jo, vlastn\u011B m\xE1te pravdu! Prav\xFD \u0161ampion se soust\u0159ed\xED i v torn\xE1du!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Ty duniv\xE9 basy z Dance Monkey mi rezonuj\xED p\u0159\xEDmo do tla\u010D\xEDtek na Petrisu, st\xE1hn\u011Bte subwoofer!"
    negative:
      text: "J\xE1 to klidn\u011B st\xE1hnu \xFApln\u011B na nulu, jen na m\u011B pros\xEDm tak nevyj\xED\u017Ed\u011Bjte..."
      guestReply: "Kone\u010Dn\u011B rozumn\xE1 \u0159e\u010D. Jdu zkusit ten turnajov\xFD rekord, te\u010F to kone\u010Dn\u011B d\xE1m."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "M\u016F\u017Eu st\xE1hnout master volume o jeden stupe\u0148, ale lidi sem chod\xED za atmosf\xE9rou."
      guestReply: "Jeden stupe\u0148 bude muset sta\u010Dit. Aspo\u0148 l\xE9pe zachyt\xEDm zvukov\xFD sign\xE1l pro \xFAskok."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Soust\u0159ed\u011Bn\xED?! Kdy\u017E m\xE1\u0161 timing v krvi, nerozhod\xED t\u011B ani vlak! Makej a nevymlouvej se!"
      guestReply: "\u017De se vymlouv\xE1m?! J\xE1 ti uk\xE1\u017Eu takov\xFD timing, \u017Ee ti z toho spadnou hodinky ze zdi! Jdu do toho!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Ten blikaj\xEDc\xED neonov\xFD n\xE1pis nad Flappy Pigeon mi h\xE1z\xED odlesky na displej, vypn\u011Bte ho!"
    negative:
      text: "Moc se omlouv\xE1m za ru\u0161en\xED... j\xE1 nev\u011Bd\u011Bl, \u017Ee ty basy z Flappy Pigeon dun\xED a\u017E k v\xE1m."
      guestReply: "Dun\xED to p\u0159\xED\u0161ern\u011B! Jdu to zkusit odehr\xE1t i p\u0159es tenhle amat\xE9rsk\xFD rand\xE1l."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Osv\u011Btlen\xED herny je navr\u017Een\xE9 pro autentickou retro atmosf\xE9ru a nemohu ho m\u011Bnit."
      guestReply: "Fajn, beru na v\u011Bdom\xED. Budu se muset pono\u0159it do hry hloub\u011Bji a soust\u0159edit se."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Tady se hraje na pln\xFD decibely! Kup si \u0161punty, nebo p\u0159epni na vy\u0161\u0161\xED hern\xED level!"
      guestReply: "\u0160punty do u\u0161\xED nepot\u0159ebuju, j\xE1 ten hluk prost\u011B p\u0159ehraju vlastn\xEDm sk\xF3re! Koukejte na to!"
      socialBatteryChange: -1
      money: 10
