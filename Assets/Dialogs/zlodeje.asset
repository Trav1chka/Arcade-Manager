%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 300f5844559acab45b0a9637e17f2a48, type: 3}
  m_Name: zlodeje
  m_EditorClassIdentifier: Assembly-CSharp::DialogGroup
  groupName: 
  leaveChanceOnNegative: 0.5
  entries:
  - guestPhrase: "K\xE1mo, docela to tu m\xE1\u0161 pln\xFD. B\xFDv\xE1\u0161 tu za t\xEDm pultem takhle s\xE1m a\u017E do zav\xEDra\u010Dky?"
    negative:
      text: "V\u011Bt\u0161inou jo, jsem tu s\xE1m... Douf\xE1m, \u017Ee dneska nikdo nebude d\u011Blat probl\xE9my."
      guestReply: "S\xE1m, jo? Heh, dobr\xFD v\u011Bd\u011Bt... Dej mi teda \u017Eeton a koukej si m\u011B nev\u0161\xEDmat."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Zav\xEDr\xE1me v deset a do t\xE9 doby m\xE1m hernu pln\u011B pod kontrolou. Chce\u0161 m\u011Bnit \u017Eetony?"
      guestReply: "Kl\xEDdek, jen se pt\xE1m. Tady m\xE1\u0161 prachy na \u017Eetony, jdu hr\xE1t."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "S\xE1m? M\xE1m tu napojen\xFDch osm kamer na policii a pod pultem baseballku. Probl\xE9m?"
      guestReply: "Hej, v klidu! Nic nezkou\u0161\xEDm, jen jsem se ptal! Dej mi rad\u0161i \u017Eetony za stovku."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Kdy ti vlastn\u011B kon\u010D\xED \u0161\xE9f sm\u011Bnu? Nebo tu na noc zamyk\xE1\u0161 \xFApln\u011B s\xE1m?"
    negative:
      text: "\u0160\xE9f tu ve\u010Der neb\xFDv\xE1 a nikdo dal\u0161\xED nep\u0159ijde... zamyk\xE1m to s\xE1m."
      guestReply: "\xDApln\u011B s\xE1m po zav\xEDra\u010Dce? Jasn\xFD, to se je\u0161t\u011B uvid\xED..."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Rozpisy sm\u011Bn jsou intern\xED v\u011Bc podniku. Zaj\xEDmaj\xED t\u011B automaty, nebo n\u011Bco jin\xE9ho?"
      guestReply: "Ch\xE1pu t\u011B. Jdu se pod\xEDvat dozadu po ma\u0161in\xE1ch."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Zrovna \u010Dek\xE1m, a\u017E doraz\xED hl\xEDdka ze sekuri\u0165\xE1k\u016F na obch\u016Fzku, tak\u017Ee jestli nehraje\u0161, miz!"
      guestReply: "U\u017E jdu, u\u017E jdu k automat\u016Fm. Nemus\xED\u0161 bejt hned tak agresivn\xED!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "M\xE1te tady v hern\u011B n\u011Bjak\xFD zadn\xED nouzov\xFD v\xFDchod, nebo se chod\xED jen kolem kasy?"
    negative:
      text: "Zadn\xED dve\u0159e vedou do dvora, ale boj\xEDm se tam v noci chodit..."
      guestReply: "Zadn\xED dv\u016Fr, jo? Par\xE1da... Tak j\xE1 jdu hodit minci do hry."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Nouzov\xE9 \xFAnikov\xE9 cesty jsou ozna\u010Den\xE9 zelen\xFDmi tabulkami a hl\xEDdan\xE9 alarmem."
      guestReply: "Dob\u0159e, dob\u0159e, ned\u011Blej vlny. D\xE1m si p\xE1r \u017Eeton\u016F a jdu pa\u0159it."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Kudy bys cht\u011Bl ut\xEDkat t\u011B nemus\xED zaj\xEDmat! Sleduj hru a nevym\xFD\u0161lej blbosti!"
      guestReply: "Fajn, se\u0161 n\u011Bjakej ostrej. Jdu dop\u0159edu na Miami Drive a nic ne\u0159e\u0161\xEDm."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Nem\xE1\u0161 cig\xE1ro? A ne\u0159\xEDkej to m\xFDmu t\xE1tovi, nebo ti to tu rozml\xE1t\xEDm."
    negative:
      text: "J\xE1 nekou\u0159\xEDm... A fakt t\u011B pros\xEDm, hlavn\u011B tu nic nerozb\xEDjej, m\u011Bl bych z toho mal\xE9r."
      guestReply: "Hehe, tak vid\xED\u0161, jak se klepe\u0161. Rad\u0161i bu\u010F zticha, oto\u010D se a nic se ti nestane."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Cigarety tu nevedeme a vyhro\u017Eov\xE1n\xED si nech za dve\u0159e. Chovej se slu\u0161n\u011B, nebo odejdi."
      guestReply: "Tss, jen jsem to zkou\u0161el. Kl\xEDdek, jdu k automat\u016Fm."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Rozml\xE1t\xED\u0161?! Jestli zk\u0159iv\xED\u0161 kabel, vyraz\xEDm s tebou dve\u0159e a vol\xE1m t\xE1tu i policii!"
      guestReply: "Ne! Dob\u0159e, omlouv\xE1m se, hlavn\u011B nikam nevolej! U\u017E jdu hr\xE1t!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Ho\u010F mi sem z lednice dv\u011B coly zadarmo, nebo ti venku prop\xEDchnu kolo u auta."
    negative:
      text: "To kolo je nov\xE9... ale pit\xED zadarmo d\xE1vat nesm\xEDm, pros\xEDm t\u011B nech toho..."
      guestReply: "M\xE1\u0161 kliku, \u017Ee ml\u010D\xED\u0161. Koukej jinam a nev\u0161\xEDmej si m\u011B."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Zbo\u017E\xED z chla\u010F\xE1ku je pouze na prodej. Vyhro\u017Eov\xE1n\xED \u0161kodou hl\xE1s\xEDm policii."
      guestReply: "Trapn\xFD. Tady s nik\xFDm nen\xED \u0159e\u010D. Jdu hodit \u017Eeton do Flappy Pigeon."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Jestli s\xE1hne\u0161 na ciz\xED majetek, vylet\xED\u0161 z herny tak rychle, \u017Ee ztrat\xED\u0161 boty!"
      guestReply: "Fajn, fajn! Nech m\u011B bejt, vezmu si \u017Eetony a jdu hr\xE1t MuckMana!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "P\u016Fj\u010D mi z kasy dv\u011B stovky na tax\xEDk. Vr\xE1t\xEDm ti to z\xEDtra, \u010Destn\xFD slovo."
    negative:
      text: "J\xE1 do tr\u017Eby sahat nesm\xEDm... m\u011Bl bych manko a \u0161\xE9f by m\u011B zabil..."
      guestReply: "To douf\xE1m, jinak si m\u011B nep\u0159ej. Kasa z\u016Fstane p\u011Bkn\u011B potichu."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Pokladna slou\u017E\xED v\xFDhradn\u011B k hern\xEDmu provozu, \u017E\xE1dn\xE9 p\u016Fj\u010Dky neposkytujeme."
      guestReply: "Ty jsi taky hroznej suchar. Dej mi \u017Eetony, jdu aspo\u0148 z\xE1vodit na Miami Drive."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "P\u016Fj\u010Dovna je vedle v bance! Tady bu\u010F vym\u011Bn\xED\u0161 prachy za \u017Eetony, nebo vypadni!"
      guestReply: "J\xE1... j\xE1 to tak nemyslel. U\u017E ml\u010D\xEDm, jdu si sednout k ma\u0161in\u011B."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Na\u0161el jsem tenhle \u017Eeton na zemi. Kdy\u017E v\xE1m ho vr\xE1t\xEDm, d\xE1te mi za n\u011Bj pen\xEDze?"
    negative:
      text: "Ehm... no, pen\xEDze za to vracet nesm\xEDm... Pros\xEDm ned\u011Blej tu rozruch..."
      guestReply: "Co se hned t\u0159ese\u0161? Dej mi aspo\u0148 dvacku z kasy, nikdo se p\u0159ece nedozv\xED!"
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "\u017Detony jsou nevratn\xE9 a nelze je m\u011Bnit zp\u011Bt na hotovost. M\u016F\u017Ee\u0161 si za n\u011Bj zahr\xE1t."
      guestReply: "Hm, \u0161koda. Tak j\xE1 to teda jdu utratit na Invaders of Personal Space."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Pen\xEDze zp\xE1tky za \u017Eetony nevypl\xE1c\xEDme! Ho\u010F ho do ma\u0161iny a nehraj tu lev\xE1rny!"
      guestReply: "Fajn, fajn, nemus\xED\u0161 hned \u0161t\u011Bkat! Jdu ho teda hodit do Petrisu."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Tenhle automat MuckMan mi v\u010Dera se\u017Eral stovku a nic mi nedal! Chci cash zp\xE1tky!"
    negative:
      text: "V\u010Dera jsem tu nebyl... j\xE1 nev\xEDm, jestli to je pravda, ale boj\xEDm se h\xE1dat..."
      guestReply: "V pokladn\u011B m\xE1\u0161 dost, tak nevym\xFD\u0161lej poh\xE1dky a syp to sem, nebo si to vezmu s\xE1m."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Reklamace ze v\u010Derej\u0161ka prov\u011B\u0159uji v servisn\xED knize a kamerov\xE9m z\xE1znamu."
      guestReply: "Rozum\xEDm, pravidla jsou pravidla. Jdu to teda rad\u0161i odp\xE1lit do hry."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Stovku?! MuckMan m\xE1 po\u010D\xEDtadlo kredit\u016F na \u010Dipu, ty poh\xE1dk\xE1\u0159i! B\u011B\u017E hr\xE1t a nel\u017Ei!"
      guestReply: "Kl\xEDdek, \u0161\xE9fe! Nech\xE1m si ho a jdu k automatu Ping, netla\u010D na m\u011B."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "M\xE1m tu ciz\xED \u017Eeton z jin\xE9 herny, vym\u011B\u0148 mi ho za v\xE1\u0161, m\xE1 stejnou velikost."
    negative:
      text: "J\xE1 nev\xEDm, jestli to m\u016F\u017Eu vz\xEDt... asi bych z toho m\u011Bl pr\u016F\u0161vih u inventury..."
      guestReply: "Vid\xED\u0161, \u017Ee to jde. Koukej mi navalit aspo\u0148 pades\xE1tikorunu a nikdo nic nevid\u011Bl."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "P\u0159ij\xEDm\xE1me pouze na\u0161e origin\xE1ln\xED ra\u017Een\xE9 \u017Eetony. Ciz\xED m\u011Bna do mechaniky nesm\xED."
      guestReply: "Aha, tak d\xEDk no. Jdu zkusit \u0161t\u011Bst\xED na Grab."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Ciz\xED pl\xED\u0161ky si str\u010D do kapsy! Jestli to nacpe\u0161 do mincovn\xEDku, zaplat\xED\u0161 servis!"
      guestReply: "U\u017E miz\xEDm, u\u017E miz\xEDm! Jdu na General, nestarej se o m\u011B."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "K\xE1mo, pootev\u0159i mi ten mincovn\xEDk na Miami Drive, zapadla mi tam dvacka."
    negative:
      text: "J\xE1... j\xE1 od toho nem\xE1m kl\xED\u010De u sebe a boj\xEDm se do t\u011Bch ma\u0161in sahat..."
      guestReply: "Nem\xE1\u0161 kl\xED\u010De? Tak j\xE1 si ten plech vyp\xE1\u010D\xEDm s\xE1m, jestli mi ty prachy nevr\xE1t\xED\u0161!"
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Mincovn\xEDky b\u011Bhem otev\xEDrac\xED doby z\xE1sadn\u011B neotv\xEDr\xE1m. Tady m\xE1\u0161 n\xE1hradn\xED \u017Eeton a hraj."
      guestReply: "Fajn, beru \u017Eeton. Hlavn\u011B \u017Ee nemus\xEDm platit znova."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Kl\xED\u010De od mincovn\xEDk\u016F neopust\xED tenhle pult! Zkontroluju to na kame\u0159e. Zp\u011Bt!"
      guestReply: "Dobr\xFD, kl\xEDdek! Jen jsem se zeptal, nemus\xED\u0161 hned vy\u0161ilovat. D\xE1m tam sv\u016Fj \u017Eeton."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Hele, ten automat Invaders of Personal Space spolykal \u017Eeton a nenasko\u010Dil kredit. Otev\u0159i to."
    negative:
      text: "Je\u017E\xED\u0161, to snad ne... Pros\xEDm t\u011B, hlavn\u011B do toho nekopej, j\xE1 nev\xEDm, co s t\xEDm d\u011Blat..."
      guestReply: "Kdy\u017E jsi neschopnej, tak uhni z cesty, j\xE1 si ten mincovn\xEDk otev\u0159u \u0161roubov\xE1kem s\xE1m."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Do mechaniky automat\u016F se za provozu nezasahuje. D\xE1m ti n\xE1hradn\xED kredit ze syst\xE9mu."
      guestReply: "D\xEDk, to mi sta\u010D\xED. Jdu to teda odjet."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Ruce pry\u010D od \u0161achet! Jsi pod kamerou, jestli na z\xE1mek s\xE1hne\u0161, vol\xE1m policii!"
      guestReply: "Hej, nic nep\xE1\u010D\xEDm! U\u017E stoj\xEDm d\xE1l. Jdu si norm\xE1ln\u011B koupit \u017Eeton."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Zasekl se mi \u017Eeton ve \u0161t\u011Brbin\u011B u Petrisu, kouk\xE1 jen kousek, dej mi kle\u0161t\u011B nebo to vyp\xE1\u010D."
    negative:
      text: "J\xE1 kle\u0161t\u011B za pultem nem\xE1m... pros\xEDm hlavn\u011B do toho netahej moc silou..."
      guestReply: "Tak vid\xED\u0161, \u017Ee to jde, kdy\u017E zatla\u010D\xEDm. Naval dva \u017Eetony a budeme vyrovnan\xED."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Pokud automat nevzal \u017Eeton spr\xE1vn\u011B, vy\u0159e\u0161\xEDme to n\xE1hradn\xEDm kusem z kasy."
      guestReply: "Dobr\xE1, tak mi dej ten \u017Eeton a j\xE1 jdu z\xE1vodit."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Ani n\xE1pad! Tady \u017E\xE1dn\xFD bedny p\xE1\u010Dit nebude\u0161! Tady m\xE1\u0161 kredit a krok od stroje!"
      guestReply: "U\u017E ml\u010D\xEDm! Tady m\xE1\u0161 pen\xEDze na \u017Eeton a neka\u017E mi den."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Co kdy\u017E si vezmu ty ply\u0161\xE1ky z Grabu horem? Stejn\u011B je ten z\xE1mek naho\u0159e uvoln\u011Bn\xFD."
    negative:
      text: "Pros\xEDm t\u011B, to ned\u011Blej... Majitel by to strhnul mn\u011B z v\xFDplaty a m\u011Bl bych pr\u016F\u0161vih..."
      guestReply: "Tv\u016Fj probl\xE9m, k\xE1mo. Kdy\u017E se bude\u0161 koukat do zdi, tak si nikdo ni\u010Deho nev\u0161imne."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Jak\xFDkoliv z\xE1sah do automatu bereme jako pokus o kr\xE1de\u017E. Jestli na to s\xE1hne\u0161, vol\xE1m hl\xEDdku."
      guestReply: "U\u017E ml\u010D\xEDm, nic neberu. Jdu rad\u0161i h\xE1zet \u017Eetony do Dance Monkey."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "P\u0159\xEDmo nad tebou vis\xED kamera a m\xE1m ruku na alarmu! Krok ke sklu a odj\xED\u017Ed\xED\u0161 v poutech!"
      guestReply: "Hej, dobr\xFD, to byl jen vtip! U\u017E jdu od toho pry\u010D, vid\xED\u0161? Jdu hr\xE1t Ping!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Ten Gumball Machine m\xE1 plastov\xFD kryt, co kdybych s n\xEDm trochu zat\u0159\xE1sl a vypadly \u017Ev\xFDka\u010Dky?"
    negative:
      text: "To nesm\xED\u0161... J\xE1 sice od pultu nem\u016F\u017Eu, ale opravdu t\u011B pros\xEDm, nech to b\xFDt..."
      guestReply: "Kdy\u017E od pultu nem\u016F\u017Ee\u0161, tak co mi ud\u011Bl\xE1\u0161? Zkus\xEDm tam rad\u0161i hodit \u017Eeton s\xE1m."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Z\xE1sobn\xEDk je mechanicky ji\u0161t\u011Bn\xFD. Hraj pomoc\xED oto\u010Dn\xE9ho mechanismu jako ostatn\xED."
      guestReply: "Fajn, zkus\xEDm to tou p\xE1kou. Snad ten h\xE1k aspo\u0148 n\u011Bco udr\u017E\xED."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Ustup od automatu na t\u0159i kroky! Pokus o po\u0161kozen\xED znamen\xE1 okam\u017Eit\xFD vyhazov!"
      guestReply: "Dobr\xFD, u\u017E stoj\xEDm u dve\u0159\xED! Nech ty f\xEDzly bejt, d\xE1m si rad\u0161i \u017Evejku z Gumball Machine."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Kouk\xE1m, \u017Ee zadn\xED st\u011Bna u MuckMana nen\xED p\u0159i\u0161roubovan\xE1. Co tam schov\xE1v\xE1te za kabely?"
    negative:
      text: "J\xE1 nev\xEDm, co bych d\u011Blal, kdyby se tam n\u011Bco zkratovalo... pros\xEDm nesahej tam..."
      guestReply: "Kdy\u017E se boj\xED\u0161, tak rad\u0161i \u010Dum do zem\u011B a d\u011Blej, \u017Ee tu nejsi. J\xE1 u\u017E si porad\xEDm."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Zadn\xED panely chr\xE1n\xED vnit\u0159n\xED elektroniku pod vysok\xFDm nap\u011Bt\xEDm. Vstup za automaty je zak\xE1z\xE1n."
      guestReply: "Dob\u0159e no, zkus\xEDm to poctiv\u011B. Dej mi dva \u017Eetony."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Okam\u017Eit\u011B ruce dol\u016F! Jestli vleze\u0161 za kabinety, ochranka t\u011B zpacifikuje na m\xEDst\u011B!"
      guestReply: "Kl\xEDdek, \u0161\xE9fe! Nic jsem neud\u011Blal, jen jsem si ten automat prohl\xED\u017Eel. U\u017E jdu na General."
      socialBatteryChange: -1
      money: 10
