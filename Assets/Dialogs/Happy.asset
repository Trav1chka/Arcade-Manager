  groupName: Happy
  leaveChanceOnNegative: 0.5
  entries:
  - guestPhrase: "Hej! Ten zatracenej Pac-Man mi se\u017Eral minci a nic! Okam\u017Eit\u011B to b\u011B\u017E spravit!"
    negative:
      text: "Ehm... m-moc se omlouv\xE1m... tady je va\u0161e mince zp\xE1tky..."
      guestReply: 1
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "N-nemus\xEDte hned k\u0159i\u010Det... Zkuste ten automat z boku trochu popl\xE1cat... to ob\u010Das pom\u016F\u017Ee."
      guestReply: 2
      socialBatteryChange: -2
      money: 3
    positive:
      text: "Kl\xEDdek, \u0161\xE9fe! Tyhle star\xFD ma\u0161iny maj\xED svou hlavu. Hned tam sko\u010D\xEDm a vy\u0159e\u0161\xEDm to, vy si zat\xEDm dejte kolu na \xFA\u010Det podniku, jo?"
      guestReply: 3
      socialBatteryChange: -1
      money: 5
