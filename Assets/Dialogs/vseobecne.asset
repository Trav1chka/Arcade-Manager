%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 300f5844559acab45b0a9637e17f2a48, type: 3}
  m_Name: vseobecne
  m_EditorClassIdentifier: Assembly-CSharp::DialogGroup
  groupName: 
  leaveChanceOnNegative: 0.5
  entries:
  - guestPhrase: "M\xE1te rozm\u011Bnit stovku na \u017Eetony?"
    negative:
      text: "Jasn\xE1 v\u011Bc, \u0161\xE9fe! Tady je munice, b\u011B\u017Ete jim u automat\u016F uk\xE1zat, kdo je tu p\xE1n!"
      guestReply: "Ehm... tak jo... d\xEDky, asi? J\xE1 si cht\u011Bl jen na chv\xEDli sednout k Petrisu..."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Jist\u011B, tady jsou. Deset kus\u016F za stovku."
      guestReply: "D\xEDky, to je p\u0159esn\xE9."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Jasn\u011B, tady m\xE1te deset \u017Eeton\u016F. P\u0159eju p\u0159\xEDjemnou z\xE1bavu a a\u0165 se v\xE1m da\u0159\xED!"
      guestReply: "D\xEDky moc, jste velice ochotn\xFD! Snad dneska poko\u0159\xEDm n\u011Bjak\xE9 to sk\xF3re."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Dobr\xFD den, rozm\u011Bnil byste mi pades\xE1tikorunu na \u017Eetony, pros\xEDm?"
    negative:
      text: "Pade?! To sotva stihnete zap\xE1lit motor na Miami Drive! Kupte rovnou dv\u011B stovky!"
      guestReply: "Proboha... jen jsem cht\u011Bl rozm\u011Bnit pades\xE1t. Nemus\xEDte na m\u011B tak halekat."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Samoz\u0159ejm\u011B, tady m\xE1te p\u011Bt \u017Eeton\u016F. P\u0159eji hezkou hru."
      guestReply: "Sed\xED to, d\u011Bkuji v\xE1m."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Ur\u010Dit\u011B, tady m\xE1te \u017Eetony z kasy. Kdybyste pot\u0159eboval poradit, klidn\u011B se zeptejte!"
      guestReply: "Moc v\xE1m d\u011Bkuju, to je mil\xE9. Ur\u010Dit\u011B se kdy\u017Etak stav\xEDm."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Dobr\xFD den, berete u kasy i platby kartou, nebo mus\xEDm m\xEDt hotovost?"
    negative:
      text: "Kartou?! Tohle je hardcore devades\xE1tkov\xE1 ark\xE1da! \u0160ustit mus\xED pap\xEDr a cinkat kov!"
      guestReply: "Aha... j\xE1 myslel, \u017Ee \u017Eijeme v 21. stolet\xED. Rad\u0161i p\u016Fjdu n\u011Bkam do rohu."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Termin\xE1l m\xE1me hned vedle kasy. Sta\u010D\xED p\u0159ilo\u017Eit kartu a zvolit po\u010Det \u017Eeton\u016F."
      guestReply: "Skv\u011Bl\xE9, hotovost u sebe moc nenos\xEDm. D\u011Bkuji."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Bohu\u017Eel zat\xEDm jen hotovost, ale hned naproti v uli\u010Dce je bankomat. Klidn\u011B v\xE1m po\u010Dk\xE1m!"
      guestReply: "D\u011Bkuji, p\u0159esn\u011B to po dne\u0161ku v kanclu pot\u0159ebuju, hned si tam sko\u010D\xEDm."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Ten automat v rohu je rozbitej, se\u017Eralo mi to minci a nic!"
    negative:
      text: "Ten zmetek m\xE1 dneska zase hlad! Po \u0161icht\u011B mu uk\xE1\u017Eu, klidn\u011B do n\u011Bj kopnu baseballkou!"
      guestReply: "Ehm, klid, pane... Je to jen automat. Nemus\xEDte p\u0159ed lidmi tak vyv\xE1d\u011Bt."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Star\u0161\xED stroje ob\u010Das zadrhnou. Tady je va\u0161e mince zp\xE1tky, zkuste zat\xEDm jinou hru."
      guestReply: "Jasn\u011B, ch\xE1pu, stane se. Zkus\xEDm jin\xFD automat."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Moc se omlouv\xE1m za komplikace! Tady je n\xE1hradn\xED \u017Eeton a po \u0161icht\u011B na to mrknu."
      guestReply: "D\u011Bkuji moc, to je od v\xE1s velmi f\xE9rov\xE9 a profesion\xE1ln\xED jedn\xE1n\xED."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Omlouv\xE1m se, ale na Flappy Pigeon mi nereaguje \u010Derven\xE9 skokov\xE9 tla\u010D\xEDtko."
    negative:
      text: "Nereaguje?! Mus\xEDte do toho ml\xE1tit celou p\u011Bst\xED, \u017E\xE1dn\xE9 mazlen\xED s hardwarem!"
      guestReply: "Vy jste docela divokej... Jen jsem cht\u011Bl \u0159\xEDct, \u017Ee tla\u010D\xEDtko nefunguje."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "D\u011Bkuji za upozorn\u011Bn\xED. Ozna\u010D\xEDm tla\u010D\xEDtko cedulkou a tady m\xE1te kredit na jinou ma\u0161inu."
      guestReply: "Dob\u0159e, d\xEDky za vy\u0159\xEDzen\xED."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Omlouv\xE1m se, mikrosp\xEDna\u010De ob\u010Das zatuhnou. Tady m\xE1te dva \u017Eetony jako omluvu."
      guestReply: "F\xEDha, tak to v\xE1m moc d\u011Bkuji! Velmi vst\u0159\xEDcn\xFD p\u0159\xEDstup."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Na Dance Monkey mi uj\xED\u017Ed\xED synchronizace zvuku s obrazem, ned\xE1 se trefit krok."
    negative:
      text: "Tyhle veter\xE1ni pot\u0159ebujou chlapskou facku! Ho\u010F tam dal\u0161\xED prachy a zvykni si!"
      guestReply: "Dal\u0161\xED pen\xEDze tam h\xE1zet nebudu, kdy\u017E to nefunguje... Rad\u0161i mi vra\u0165te minci."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Star\xE1 zvukov\xE1 deska ob\u010Das ztrat\xED takt. Restartuji automat po zav\xEDra\u010Dce."
      guestReply: "D\xEDky, vezmu si \u017Eeton a zkus\xEDm vedlej\u0161\xED Miami Drive."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "To m\u011B mrz\xED! Zpoza kasy to te\u010F neoprav\xEDm, ale tady m\xE1te rovnou n\xE1hradn\xED kredit."
      guestReply: "To je skv\u011Bl\xE9, mockr\xE1t d\u011Bkuju za ochotu!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "M\u016F\u017Eu si sem vz\xEDt to j\xEDdlo z fastfoodu odvedle?"
    negative:
      text: "J\xEDdlo zvenku?! To t\u011B bude st\xE1t p\u016Flku hranolek jako clo! A joystick pak bude\u0161 l\xEDzat!"
      guestReply: "Panebo\u017Ee, j\xE1 se jen norm\xE1ln\u011B zeptal... Sn\xEDm to u stole\u010Dku a nev\u0161\xEDmejte si m\u011B."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "M\u016F\u017Eete, ale nejezte p\u0159\xEDmo nad tla\u010D\xEDtky. B\u011B\u017Ete si sednout t\xE1mhle ke stolu."
      guestReply: "Dob\u0159e, sednu si tamhle do rohu. D\xEDky."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Ur\u010Dit\u011B m\u016F\u017Eete, jen se pros\xEDm posa\u010Fte k tomu stolku, a\u0165 nezamast\xEDte tla\u010D\xEDtka."
      guestReply: "Rozum\xEDm, d\xE1m si velk\xFD pozor a posad\xEDm se ke stolu. D\u011Bkuji!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "M\xE1m s sebou kel\xEDmek s k\xE1vou, m\u016F\u017Eu si ho odlo\u017Eit na desku automatu?"
    negative:
      text: "Zaparkuj ten kel\xEDmek kam chce\u0161! Ale jestli polije\u0161 z\xE1kladn\xED desku, donut\xEDm t\u011B to vyp\xEDt!"
      guestReply: "Rad\u0161i si d\xE1m velk\xFD pozor. Polo\u017E\xEDm to na stolek a nev\u0161\xEDmejte si m\u011B."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Na sk\u0159\xEDn\u011B automat\u016F tekutiny nepat\u0159\xED. Pros\xEDm odlo\u017Ete si n\xE1poj na serv\xEDrovac\xED stolek."
      guestReply: "Ch\xE1pu pravidla, sednu si dozadu ke stolku."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Klidn\u011B ke stole\u010Dku u okna! M\xE1me tam i podt\xE1cky, a\u0165 se v\xE1m k\xE1va nep\u0159evrhne."
      guestReply: "Vy jste skv\u011Bl\xFD, podt\xE1cky ur\u010Dit\u011B vyu\u017Eiju! D\xEDky moc za vst\u0159\xEDcnost."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Prod\xE1v\xE1te tady u pultu n\u011Bjak\xE9 mal\xE9 ob\u010Derstven\xED, chipsy nebo ty\u010Dinky?"
    negative:
      text: "Chipsy v ark\xE1dovn\u011B?! A\u0165 majon\xE9za a mastnota st\u0159\xEDk\xE1 v\u0161ude po tla\u010D\xEDtk\xE1ch!"
      guestReply: "Mastnotu po tla\u010D\xEDtk\xE1ch rozhodn\u011B nechci... Jen jsem m\u011Bl hlad. Koup\xEDm si pit\xED."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "M\xE1me tu balen\xE9 o\u0159\xED\u0161ky a balenou vodu. Tepl\xE9 j\xEDdlo v hern\u011B nenab\xEDz\xEDme."
      guestReply: "Dob\u0159e, vezmu si miner\xE1lku."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "M\xE1me tu chlazen\xE9 n\xE1poje a su\u0161enky. Pokud chcete v\u011Bt\u0161\xED j\xEDdlo, hned vedle je bistro!"
      guestReply: "Spolehn\u011Bte se, d\xE1m na to pozor a pak to hod\xEDm do ko\u0161e. D\u011Bkuji!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Jak dlouho m\xE1te je\u0161t\u011B otev\u0159eno? M\xE1m je\u0161t\u011B p\xE1r star\xFDch kredit\u016F."
    negative:
      text: "Dokud nepadne\u0161 vy\u010Derp\xE1n\xEDm! Dneska zav\xEDra\u010Dku ne\u0159e\u0161, rozto\u010D\xEDme to a\u017E do r\xE1na!"
      guestReply: "Z\xEDtra vst\xE1v\xE1m do pr\xE1ce v \u0161est r\xE1no... Rad\u0161i si rychle odehraju kredity te\u010F."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Zav\xEDr\xE1me p\u0159esn\u011B ve 22:00. Pak se prostor uzav\xEDr\xE1 pro \xFAklid a servis."
      guestReply: "Dob\u0159e, do deseti to bez probl\xE9mu stihnu. D\u011Bkuji za informaci."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "M\xE1me otev\u0159eno je\u0161t\u011B hodinu a p\u016Fl, tak\u017Ee m\xE1te spoustu \u010Dasu si v\u0161echno u\u017E\xEDt!"
      guestReply: "Super, d\xEDky moc, to stihnu \xFApln\u011B bez stresu. Jste moc hodn\xFD!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Stihnu si je\u0161t\u011B d\xE1t jeden kompletn\xED \u0161ampion\xE1t na Miami Drive, ne\u017E zav\u0159ete?"
    negative:
      text: "\u010Cas neexistuje, kdy\u017E jsi v transu! Ka\u0161li na hodinky a hrajeme na krev!"
      guestReply: "No... pro m\u011B \u010Das docela existuje. Jdu si rad\u0161i rychle zahr\xE1t."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Z\xE1vod trv\xE1 zhruba patn\xE1ct minut. Do zav\xEDra\u010Dky zb\xFDv\xE1 p\u016Fl hodiny, tak\u017Ee bez pot\xED\u017E\xED."
      guestReply: "Rozum\xEDm, p\u016Fjdu rovnou k automatu, a\u0165 to stihnu."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Ur\u010Dit\u011B ano! M\xE1te je\u0161t\u011B \u010Dty\u0159icet minut, tak\u017Ee si m\u016F\u017Eete zajet i fin\xE1lovou tra\u0165."
      guestReply: "To je perfektn\xED zpr\xE1va! Odehraju dv\u011B hry a zbytek si nech\xE1m na v\xEDkend. D\u011Bkuji!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "V kolik hodin p\u0159esn\u011B vyp\xEDn\xE1te p\u0159\xEDvod elekt\u0159iny k automat\u016Fm?"
    negative:
      text: "B\u011B\u017E k automatu a sma\u017E ty tla\u010D\xEDtka, ne\u017E na celou hernu hod\xEDm blackout!"
      guestReply: "Pro\u010D na m\u011B po\u0159\xE1d tak k\u0159i\u010D\xEDte? Norm\xE1ln\u011B jsem se zeptal... Jdu si hodit \u017Eeton."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Provozn\xED doba kon\u010D\xED ve 22:00. P\u011Bt minut p\u0159ed koncem vyp\xEDn\xE1me p\u0159\xEDvod proudu."
      guestReply: "Jasn\u011B, beru na v\u011Bdom\xED. P\u016Fjdu si zahr\xE1t."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Automaty b\u011B\u017E\xED do 21:55, abyste stihli bezpe\u010Dn\u011B dokon\u010Dit posledn\xED rozehranou hru."
      guestReply: "D\xEDky moc za ochotu, p\u0159esn\u011B to jsem pot\u0159eboval v\u011Bd\u011Bt."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Hled\xE1m n\u011Bjakou pohodovou hru na odreagov\xE1n\xED po pr\xE1ci, co byste mi doporu\u010Dil?"
    negative:
      text: "Tady nejsme v l\xE1zn\xEDch! B\u011B\u017E na Dance Monkey a tancuj, dokud nepadne\u0161 na hubu!"
      guestReply: "Po sm\u011Bn\u011B na nohou rozhodn\u011B tancovat nechci... Rad\u0161i si vyberu s\xE1m."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "M\xE1me tu sekci logick\xFDch her v prav\xE9m rohu a Miami Drive vzadu."
      guestReply: "D\u011Bkuji, projdu si ten prav\xFD roh a uvid\xEDm."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Po n\xE1ro\u010Dn\xE9m dni v\u0159ele doporu\u010Duju n\xE1\u0161 Ping nebo Petris na \u010Dist\xE9 vypnut\xED hlavy."
      guestReply: "To zn\xED jako skv\u011Bl\xFD n\xE1pad! Petris jsem nehr\xE1l snad deset let, moc d\u011Bkuju za tip."
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "Cht\u011Bl bych si zahr\xE1t n\u011Bco ak\u010Dn\u011Bj\u0161\xEDho, kde se d\xE1 vyb\xEDt p\u0159ebyte\u010Dn\xE1 energie."
    negative:
      text: "\u017D\xE1dnej chill! B\u011B\u017E na General a rozmla\u0165 tam virtu\xE1ln\xED lebky! Vybij vztek do p\xE1ky!"
      guestReply: "J\xE1 ale \u017E\xE1dn\xFD vztek nem\xE1m, m\u011Bl jsem hezk\xFD den... Jdu rad\u0161i zkusit ten Ping."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Pro akci m\xE1me bojovku General nebo st\u0159\xEDle\u010Dku Invaders of Personal Space."
      guestReply: "D\xEDky, pod\xEDv\xE1m se na ty Invadery."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Zkuste General v p\u0159edn\xED \u0159ad\u011B! Je to skv\u011Bl\xE1 ak\u010Dn\xED j\xEDzda s jednoduch\xFDm ovl\xE1d\xE1n\xEDm."
      guestReply: "V\xFDborn\u011B, ak\u010Dn\xED hra zn\xED jako p\u0159esn\u011B to prav\xE9. D\u011Bkuji za doporu\u010Den\xED!"
      socialBatteryChange: -1
      money: 10
  - guestPhrase: "M\xE1te tady n\u011Bjakou klasiku, co bav\xED naprosto ka\u017Ed\xE9ho bez ohledu na v\u011Bk?"
    negative:
      text: "Pohodov\xE1 hra neexistuje! B\u011B\u017E k Invaders of Personal Space zachr\xE1nit sv\u011Bt p\u0159ed \u0161mejdem!"
      guestReply: "Tak to jste m\u011B v\u016Fbec nepochopil. D\xE1m si \u017Ev\xFDka\u010Dku z automatu a vyberu si s\xE1m."
      socialBatteryChange: -3
      money: 1
    neutral:
      text: "Nejhran\u011Bj\u0161\xED univerz\xE1ln\xED tituly jsou Petris a MuckMan uprost\u0159ed herny."
      guestReply: "Dob\u0159e, pod\xEDv\xE1m se na rozpis u vchodu."
      socialBatteryChange: -2
      money: 5
    positive:
      text: "Jednozna\u010Dn\u011B MuckMan! Nostalgie, co chytne ka\u017Ed\xE9ho a pravidla pochop\xEDte za dv\u011B vte\u0159iny."
      guestReply: "To zn\xED ide\xE1ln\u011B, star\xFD dobr\xFD MuckMan nikdy nezklame. Moc d\u011Bkuji za radu!"
      socialBatteryChange: -1
      money: 10
